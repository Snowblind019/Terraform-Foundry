# Provider plugins. Hundreds of MB, re-downloaded by terraform init.
.terraform/

# State files. Plaintext record of everything Terraform manages, including
# values that were secret when they went in.
*.tfstate
*.tfstate.*
crash.log

# Variable files, which is where credentials usually end up.
*.tfvars
*.tfvars.json

# Saved plan output.
*.tfplan

# Keep the lock file. It pins exact provider versions and should be committed.
!.terraform.lock.hcl